{
  "name": "team-bases-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Закрытый реестр Google Таблиц для команды на Google Apps Script",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "push": "clasp push",
    "deploy": "node scripts/deploy.mjs",
    "configure": "node scripts/configure.mjs"
  },
  "devDependencies": { "@google/clasp": "3.4.1" },
  "overrides": {
    "gcp-metadata@8.1.4": { "gaxios": "7.3.1" },
    "googleapis-common@8.0.3": { "gaxios": "7.3.1" }
  }
}
